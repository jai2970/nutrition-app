// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
}

enum DietType {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  name           String?
  age            Int?
  sex            Sex?
  heightCm       Float?
  weightKg       Float?
  activityLevel  ActivityLevel?
  dietType       DietType?
  goal           Goal?
  createdAt      DateTime       @default(now())
  entries        FoodEntry[]
  accounts       Account[]
  sessions       Session[]
  advisorQueries AdvisorQuery[]
}

// NextAuth (Auth.js v5) Prisma adapter tables — required shape, see
// https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FoodItem {
  id              String      @id @default(cuid())
  name            String      @unique
  aliases         String[]    @default([])
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  servingSizeG    Float       @default(100)
  servingLabel    String
  entries         FoodEntry[]

  // IFCT (Indian Food Composition Tables) metadata — null on the original
  // hand-curated rows. localNames is a free-text list of regional names.
  ifctCode       String? @unique
  scientificName String?
  foodGroup      String?
  diet           String?
  localNames     String?
  fibrePer100g   Float?

  // 768-dim gemini-embedding-001 vector for semantic search (pgvector).
  // Prisma can't read/write this type, so it's only touched through raw SQL
  // (see src/lib/food-search.ts and scripts/seed-ifct.ts).
  embedding Unsupported("vector(768)")?
}

model FoodEntry {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  foodItem   FoodItem? @relation(fields: [foodItemId], references: [id])
  foodItemId String?
  grams      Float
  meal       Meal      @default(BREAKFAST)
  consumedAt DateTime  @default(now())

  // Set instead of foodItem/foodItemId when Gemini identifies a food that
  // isn't in the database — these are the AI's estimated macros for the
  // whole logged portion (not per-100g), taken as-is at log time.
  customFoodName String?
  customCalories Float?
  customProtein  Float?
  customCarbs    Float?
  customFat      Float?
}

// One row per diet-advisor chat question — doubles as the daily rate-limit
// counter (count rows since midnight) so the limit survives serverless
// cold starts, unlike an in-memory counter.
model AdvisorQuery {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  question  String
  createdAt DateTime @default(now())
}
